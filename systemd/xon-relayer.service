[Unit]
Description=XON relayer (Xode + AssetHub + Ethereum)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xonrelayer
WorkingDirectory=/opt/xon-relayer
EnvironmentFile=/etc/xon-relayer.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
