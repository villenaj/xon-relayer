[Unit]
Description=XON relayer (Xode + AssetHub + Ethereum)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xonrelayer
WorkingDirectory=/opt/xon-relayer
EnvironmentFile=/etc/xon-relayer.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
# Give in-flight settles time to finish on stop - keep above SHUTDOWN_TIMEOUT_MS (default 120s).
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
