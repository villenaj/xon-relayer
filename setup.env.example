# Settings for `npm run setup` (scripts/setup.ts). Copy to setup.env - it's gitignored, since it
# holds keys. Every setting is optional; the defaults match the local zombienet + anvil setup.

# --- The two accounts ---
# Asset owner: one Substrate account (seed phrase or //Dev URI) used on BOTH Xode and AssetHub. It
# creates/mints the USDT asset and pays native tokens to the contract owner (and relayer).
ASSET_OWNER_SURI=//Alice
# Contract owner: one EVM key that deploys and owns XonVendingMachine and both gateways.
# Left empty, a new key is generated and saved to setup.out.env.
CONTRACT_OWNER_KEY=
# Relayer key. Left empty, the relayer uses the contract owner's key (dev/test only).
RELAYER_PRIVATE_KEY=

# --- Endpoints ---
XODE_WS=ws://127.0.0.1:9977
XODE_ETH_RPC=http://127.0.0.1:8546
ASSETHUB_WS=ws://127.0.0.1:9955
ASSETHUB_EVM_RPC=http://127.0.0.1:8547
ETHEREUM_RPC=http://127.0.0.1:8545
# Skip a leg entirely:
# SETUP_ASSETHUB=false
# SETUP_ETHEREUM=false

# --- Assets and amounts ---
ASSET_ID=1984
# Test USDT minted to the contract owner (and to USDT_RECIPIENTS) on every chain. On Xode and
# AssetHub, each USDT_RECIPIENTS address also gets GAS_BUFFER native tokens.
USDT_MINT=10000
# USDT_RECIPIENTS=0xBuyer1,0xBuyer2
XON_RATE=5
VENDING_RESERVE_XON=500
# Native tokens each EVM account is topped up to for gas, on every chain.
GAS_BUFFER=100
EXTERNAL_MAX_PER_DEPOSIT_USDT=100
EXTERNAL_MAX_PER_DAY_USDT=1000

# --- Ethereum ---
# Real USDT on Ethereum. Left empty, a mock USDT is deployed (refused on mainnet).
# ETHEREUM_USDT_ADDRESS=
# Pays the contract owner's gas on Ethereum. Defaults to anvil's first account on anvil.
# ETHEREUM_FUNDER_KEY=

# --- Reuse existing contracts instead of deploying new ones ---
# VENDING_ADDRESS=
# ASSETHUB_GATEWAY_ADDRESS=
# ETH_GATEWAY_ADDRESS=
# ETHEREUM_MOCK_USDT_ADDRESS=

# CONTRACTS_OUT=../contracts/out
# SETUP_OUTPUT=setup.out.env
