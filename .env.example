# --- Xode side (always required - every adapter settles through here) ---
XODE_ETH_RPC=http://127.0.0.1:8545
VENDING_ADDRESS=0xYourDeployedXonVendingMachineAddress
RELAYER_PRIVATE_KEY=0xYourRelayerPrivateKey

POLL_INTERVAL_MS=5000
# Blocks behind head before a Xode deposit is settled (a number, "safe" or "finalized").
XODE_CONFIRMATIONS=1
# Max blocks per eth_getLogs call - lower it if an RPC provider rejects the range.
LOG_CHUNK_SIZE=2000
CHECKPOINT_DIR=.checkpoints
# Record of every settle attempt (JSON Lines). Defaults to $CHECKPOINT_DIR/ledger.jsonl.
# LEDGER_FILE=/var/lib/xon-relayer/ledger.jsonl
# XODE_START_BLOCK=12345678

# --- Which adapters to run (all default to true) ---
ENABLE_XODE_ADAPTER=true
ENABLE_ASSETHUB_ADAPTER=true
ENABLE_ETHEREUM_ADAPTER=true

# --- Health, metrics and alerts ---
# /health and /metrics (Prometheus). HTTP_PORT=0 turns the server off.
# HTTP_HOST=127.0.0.1
# HTTP_PORT=9464
# Alert (and /health -> 503) when an adapter hasn't caught up to its chain head for this long.
# STALL_ALERT_AFTER_MS=600000
# Balance checks every MONITOR_INTERVAL_MS; alert when below these (unset = no alert).
# MONITOR_INTERVAL_MS=60000
# MIN_RELAYER_BALANCE_XON=10
# MIN_VENDING_RESERVE_XON=1000
# Chat webhook alerts are POSTed to (Slack, Discord, Mattermost, Google Chat).
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# On SIGTERM, wait this long for in-flight settles before exiting (keep systemd TimeoutStopSec above it).
# SHUTDOWN_TIMEOUT_MS=120000

# --- Payout caps for AssetHub/Ethereum deposits, in USDT (unset = no cap) ---
# A deposit over MAX_EXTERNAL_DEPOSIT_USDT is held for `npm run settle-held -- <tx hash>`.
# Once MAX_EXTERNAL_DAILY_USDT is paid out in a rolling 24h, those adapters pause until it frees up.
# MAX_EXTERNAL_DEPOSIT_USDT=5000
# MAX_EXTERNAL_DAILY_USDT=50000

# --- AssetHub adapter (AssetHub runs pallet-revive now - same shape as the Ethereum adapter) ---
ASSETHUB_EVM_RPC=https://your-asset-hub-eth-rpc-endpoint
ASSETHUB_GATEWAY_ADDRESS=0xYourDeployedUsdtGatewayAddressOnAssetHub
# ASSETHUB_START_BLOCK=12345678
# Payouts for AssetHub/Ethereum deposits can't be reversed, so these default to "finalized".
# ASSETHUB_CONFIRMATIONS=finalized

# --- Ethereum adapter ---
ETHEREUM_RPC=https://your-ethereum-rpc-endpoint
ETH_GATEWAY_ADDRESS=0xYourDeployedEthUsdtGatewayAddress
# ETHEREUM_START_BLOCK=18500000
# ETHEREUM_CONFIRMATIONS=finalized
