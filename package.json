{
  "name": "xon-relayer",
  "version": "1.0.0",
  "description": "Standalone relayer service that pays out XON on Xode for USDT received on Xode itself, AssetHub, or Ethereum.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/unit/*.test.ts\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "api": "node dist/api/index.js",
    "dev:api": "tsx src/api/index.ts",
    "settle-held": "node dist/tools/settleHeld.js",
    "refunds": "node dist/tools/refunds.js",
    "reconcile": "node dist/tools/reconcile.js",
    "setup": "tsx scripts/setup.ts",
    "test:e2e": "tsx test/e2e.manual.ts",
    "test:multi-buyer": "tsx test/multiBuyer.manual.ts",
    "test:poison-pill": "tsx test/poisonPill.manual.ts"
  },
  "dependencies": {
    "@polkadot/api": "^16.5.1",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
